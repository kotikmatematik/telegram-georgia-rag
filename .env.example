# OpenAI — for embeddings and answer generation
OPENAI_API_KEY=sk-...

# Telegram bot (interface) — token from @BotFather
BOT_TOKEN=123456:ABC...

# Telethon (chat history ingestion) — get these at https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Phone number of the account that is a member of the chats (format +995...)
TELEGRAM_PHONE=+995XXXXXXXXX
