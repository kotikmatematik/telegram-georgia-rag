# OpenAI — для эмбеддингов и генерации ответов
OPENAI_API_KEY=sk-...

# Telegram-бот (интерфейс) — токен от @BotFather
BOT_TOKEN=123456:ABC...

# Telethon (выгрузка истории чатов) — получить на https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Номер телефона аккаунта, который состоит в чатах (формат +995...)
TELEGRAM_PHONE=+995XXXXXXXXX
