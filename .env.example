# OpenAI — embeddings and answer generation (unless USE_AZURE_OPENAI below
# is True).
OPENAI_API_KEY=sk-...

# Groq — voice-message transcription only (src/store.py::transcribe_audio),
# via their hosted Whisper, free tier, no card needed. Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Telegram bot (interface) — token from @BotFather
BOT_TOKEN=123456:ABC...

# Telethon (chat history ingestion) — get these at https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Phone number of the account that is a member of the chats (format +995...)
TELEGRAM_PHONE=+995XXXXXXXXX

# Optional: route text generation/embeddings through Azure OpenAI instead of
# OpenAI direct (see config.USE_AZURE_OPENAI) — e.g. borrowed/sponsored
# credits. Leave both blank to use OPENAI_API_KEY above for everything.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=...

# Optional: move data/ and chroma_db/ outside the repo checkout (see
# README's Deployment section for why — on the server this keeps a code
# redeploy structurally unable to touch the live knowledge base/vector
# index). Leave both blank for local dev — config.py then falls back to the
# usual repo-relative data/ and chroma_db/.
GEORGIA_DATA_DIR=
GEORGIA_CHROMA_DIR=
